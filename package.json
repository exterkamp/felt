{
  "name": "@exterkamp/felt",
  "version": "0.1.0",
  "description": "A WebGL2 engine for card games and nothing else: one instanced draw for every card on the table, flat or bent, flipped or thrown.",
  "license": "CC0-1.0",
  "author": "Shane Exterkamp",
  "homepage": "https://exterkamp.github.io/felt/",
  "bugs": "https://github.com/exterkamp/felt/issues",
  "keywords": [
    "cards",
    "card-game",
    "playing-cards",
    "webgl2",
    "solitaire",
    "poker",
    "game-engine"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "ATTRIBUTION.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run typecheck && vitest run",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.spec.json && tsc -p tsconfig.demo.json",
    "demo": "vite",
    "demo:build": "vite build",
    "demo:serve": "vite preview",
    "smoke": "node tools/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exterkamp/felt.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
