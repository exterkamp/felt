{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@exterkamp/felt": ["src/index.ts"], "@exterkamp/felt/core": ["src/core/index.ts"] },
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false
  },
  "include": ["demo/**/*.ts", "src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
